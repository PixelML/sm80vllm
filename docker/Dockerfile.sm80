# Full CUDA source build of the `sm80` branch for NVIDIA Ampere
# (compute capability 8.0, e.g. CMP 170HX / A100). Build from the repo
# root: `docker build -f docker/Dockerfile.sm80 -t <tag> .`
#
# Lineage: haosdent/vllm@dsv4-flash-a100 Dockerfile.fullbuild16 (16-job
# variant of the allover326 Dockerfile.fullbuild), same torch pin and
# SM80-only arch list. See docs/SM80.md for branch provenance.
FROM nvidia/cuda:13.0.2-cudnn-devel-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3.12 python3.12-dev python3.12-venv git build-essential curl \
        ca-certificates ccache cmake ninja-build \
    && rm -rf /var/lib/apt/lists/*
RUN python3.12 -m venv /opt/venv
ENV PATH=/opt/venv/bin:/usr/local/cuda/bin:/usr/lib/ccache:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ENV CUDA_HOME=/usr/local/cuda

WORKDIR /vllm
COPY . /vllm/

ENV SETUPTOOLS_SCM_PRETEND_VERSION=0.0.0
ENV TORCH_CUDA_ARCH_LIST=8.0
ENV MAX_JOBS=16
ENV CMAKE_BUILD_TYPE=Release
ENV VLLM_TARGET_DEVICE=cuda

RUN pip install --no-cache-dir -U pip "setuptools>=77.0.3,<81.0.0" wheel \
        "setuptools-scm>=8.0" "setuptools-rust>=1.9.0" ninja "cmake>=3.26.1" \
        "packaging>=24.2" jinja2
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs \
      | sh -s -- -y --default-toolchain 1.95 --profile minimal
ENV PATH=/root/.cargo/bin:$PATH
RUN pip install --no-cache-dir torch==2.13.0 torchaudio==2.11.0 torchvision==0.28.0

RUN rustc --version && pip install --no-cache-dir -e . --no-build-isolation

# Runtime overlay: F8_E8M0 dtype support for the installed safetensors
# package (see patches/README.md). Applied after the editable install so
# it is not clobbered by any vllm dependency re-resolution above.
COPY patches/safetensors_torch_f8_e8m0.py \
     /opt/venv/lib/python3.12/site-packages/safetensors/torch.py

# Build + import gate: fail the build if the compiled extension, or the
# DeepSeek-V4 text/vision classes and custom ops, do not import.
RUN nvcc --version | tail -2 \
    && python3 -c "import vllm, torch; print('vllm', vllm.__version__, 'torch', torch.__version__)" \
    && ls -la /vllm/vllm/*.so \
    && python3 -c "import torch, vllm; import vllm._custom_ops as o; print('custom ops import OK')" \
    && python3 -c "\
from vllm.models.deepseek_v4.nvidia.model import DeepseekV4ForCausalLM; \
from vllm.models.deepseek_v4.nvidia.vl_model import DeepseekV4ForConditionalGeneration; \
from vllm.models.deepseek_v4.nvidia.dspark import DSparkDeepseekV4ForCausalLM; \
print('deepseek_v4 text + vision + dspark import OK')"
